# TOT 환경변수 템플릿
# 실제 값은 .env.local 에 입력하세요. .env.local 은 절대 커밋하지 않습니다.

# Cesium ion (지형·자산 토큰)
VITE_CESIUM_ION_TOKEN=

# Google Maps Platform — Photorealistic 3D Tiles
# Google Cloud 콘솔에서 "Map Tiles API" 를 활성화한 키여야 합니다.
VITE_GOOGLE_MAPS_API_KEY=

# V-World 3D API (국가공간정보포털) — 3D 수치지형도·건물
VITE_VWORLD_API_KEY=

# Kakao Maps API — POI·상권·리뷰
VITE_KAKAO_MAP_KEY=

# Naver Maps API — POI·지도 보조
VITE_NAVER_MAP_CLIENT_ID=

# 공공데이터포털 관광 API — 관광지 운영정보·문화재
VITE_DATA_GO_KR_KEY=
